{
  "name": "paper-opens-christmas-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "紙がひらく、クリスマス工房 — a honeycomb-paper Christmas tree toy for phones and tablets",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
