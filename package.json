{
  "name": "hajimete-oto-ni-naru-orgel-koubou",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "はじめて音になる、オルゴール工房 — a 4-year-old's mobile web workshop for meshing a cylinder music box",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/three": "^0.169.0",
    "playwright-core": "^1.48.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
