{
  "name": "he-staining-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HE染色シミュレーター — 1枚の標本を染め、仕上がりから操作を振り返る教材",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
